        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "\n",
        "print(\"--- 🧠 1. TIẾN HÀNH XÂY DỰNG KIẾN TRÚC MẠNG CNN PALMISTRY ---\")\n",
        "\n",
        "# Khởi tạo mô hình tuần tự\n",
        "model = Sequential([\n",
        "    # Lớp Conv lớp 1: Học các đặc trưng cạnh, góc của chỉ tay\n",
        "    Conv2D(32, (3, 3), activation='relu', input_shape=(128, 128, 3)),\n",
        "    MaxPooling2D(2, 2),\n",
        "\n",
        "    # Lớp Conv lớp 2: Học các phom xương, dáng tay phức tạp hơn\n",
        "    Conv2D(64, (3, 3), activation='relu'),\n",
        "    MaxPooling2D(2, 2),\n",
        "\n",
        "    # Lớp Conv lớp 3: Tối ưu hóa đặc trưng sâu\n",
        "    Conv2D(128, (3, 3), activation='relu'),\n",
        "    MaxPooling2D(2, 2),\n",
        "\n",
        "    # Phẳng hóa ma trận ảnh để đưa vào các lớp ẩn\n",
        "    Flatten(),\n",
        "\n",
        "    # Lớp ẩn kết nối đầy đủ (Dense) với 128 nơ-ron\n",
        "    Dense(128, activation='relu'),\n",
        "    # Dropout chống học vẹt (Overfitting)\n",
        "    Dropout(0.5),\n",
        "\n",
        "    # Lớp đầu ra phân loại đúng 4 hệ nguyên tố (Earth, Fire, Air, Water)\n",
        "    Dense(4, activation='softmax')\n",
        "])\n",
        "\n",
        "print(\"--- ⚙️ 2. BIÊN DỊCH MÔ HÌNH (COMPILE) ---\")\n",
        "model.compile(\n",
        "    optimizer=Adam(learning_rate=0.0001), # Tốc độ học nhỏ giúp mô hình hội tụ mượt mà\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "# Hiển thị bảng tóm tắt cấu trúc mạng\n",
        "model.summary()\n",
        "\n",
        "print(\"\\n--- 🚀 3. BẮT ĐẦU HUẤN LUYỆN (TRAINING) THỰC TẾ ---\")\n",
        "# Tiến hành train thử 15 Epochs (vòng lặp) để xem độ chính xác tăng tiến thế nào\n",
        "history = model.fit(\n",
        "    train_gen,\n",
        "    epochs=15,\n",
        "    validation_data=val_gen\n",
        ")\n",
        "\n",
        "print(\"\\n🎉 HOÀN THÀNH TRAIN MÔ HÌNH RỒI ÔNG ƠI!\")"
