        "import os\n",
        "import shutil\n",
        "import re\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
        "\n",
        "print(\"--- 🧠 BẮT ĐẦU CHẠY THUẬT TOÁN QUÉT VÀ PHÂN LOẠI ẢNH TỰ ĐỘNG ---\")\n",
        "\n",
        "# 1. Khởi tạo thư mục đích sạch sẽ trên máy ảo\n",
        "base_palmistry_dir = \"/content/palm_final_dataset\"\n",
        "if os.path.exists(base_palmistry_dir):\n",
        "    shutil.rmtree(base_palmistry_dir)\n",
        "\n",
        "for element in [\"Earth\", \"Fire\", \"Air\", \"Water\"]:\n",
        "    os.makedirs(os.path.join(base_palmistry_dir, element), exist_ok=True)\n",
        "\n",
        "# Hàm xác định hệ nguyên tố dựa trên ID người (Từ 1 đến 41)\n",
        "def phan_he_nguyen_to(subject_id):\n",
        "    if 1 <= subject_id <= 10:\n",
        "        return \"Earth\"\n",
        "    elif 11 <= subject_id <= 20:\n",
        "        return \"Fire\"\n",
        "    elif 21 <= subject_id <= 30:\n",
        "        return \"Air\"\n",
        "    elif 31 <= subject_id <= 41:\n",
        "        return \"Water\"\n",
        "    return None\n",
        "\n",
        "total_images = 0\n",
        "danh_sach_id_tim_thay = set()\n",
        "\n",
        "# Thuật toán thông minh: Quét toàn bộ cây thư mục không bỏ sót chỗ nào\n",
        "for root, dirs, files in os.walk(\"/content/palm_temp_extract\"):\n",
        "    folder_name = os.path.basename(root)\n",
        "\n",
        "    # Tìm số ID của người xuất hiện trong tên thư mục chứa ảnh trực tiếp\n",
        "    match = re.search(r'\\d+', folder_name)\n",
        "    if match:\n",
        "        sid = int(match.group())\n",
        "        element = phan_he_nguyen_to(sid)\n",
        "\n",
        "        if element:\n",
        "            danh_sach_id_tim_thay.add(sid)\n",
        "            for file_name in files:\n",
        "                # Kiểm tra định dạng ảnh chỉ tay (.bmp, .jpg, .png)\n",
        "                if file_name.lower().endswith(('.bmp', '.jpg', '.png')):\n",
        "                    src_path = os.path.join(root, file_name)\n",
        "                    dst_path = os.path.join(base_palmistry_dir, element, f\"person_{sid}_{file_name}\")\n",
        "                    shutil.copy(src_path, dst_path)\n",
        "                    total_images += 1\n",
        "\n",
        "print(f\"📊 Kết quả cấu trúc: Đã tìm thấy và xử lý thư mục của {len(danh_sach_id_tim_thay)}/41 người.\")\n",
        "print(f\"🎉 THÀNH CÔNG RỒI ÔNG ƠI! Tổng cộng đã gom được {total_images} ảnh thật vào 4 nhóm nguyên tố.\")\n",
        "\n",
        "# 2. Tự động kích hoạt nạp ảnh vào CNN ngay khi có ảnh thật\n",
        "if total_images > 0:\n",
        "    print(\"\\n--- 🚀 NẠP DỮ LIỆU THẬT VÀO MÔ HÌNH CNN PALMISTRY ---\")\n",
        "    datagen = ImageDataGenerator(\n",
        "        rescale=1./255,\n",
        "        rotation_range=15,\n",
        "        width_shift_range=0.1,\n",
        "        height_shift_range=0.1,\n",
        "        validation_split=0.2\n",
        "    )\n",
        "\n",
        "    train_gen = datagen.flow_from_directory(\n",
        "        base_palmistry_dir,\n",
        "        target_size=(128, 128),\n",
        "        batch_size=32,\n",
        "        class_mode='categorical',\n",
        "        subset='training'\n",
        "    )\n",
        "\n",
        "    val_gen = datagen.flow_from_directory(\n",
        "        base_palmistry_dir,\n",
        "        target_size=(128, 128),\n",
        "        batch_size=32,\n",
        "        class_mode='categorical',\n",
        "        subset='validation'\n",
        "    )\n",
        "else:\n",
        "    print(\"\\n❌ LỖI: Vẫn không tìm thấy ảnh. Ông hãy tạo 1 ô mã mới bên dưới, gõ lệnh `!ls -R /content/palm_temp_extract | head -n 30` rồi chạy để tôi xem cấu trúc bên trong file zip của ông nhé!\")"
